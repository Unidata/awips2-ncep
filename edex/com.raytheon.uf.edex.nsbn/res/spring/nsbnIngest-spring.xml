<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="nsbnFileChangedStrategy" class="com.raytheon.uf.edex.esb.camel.FileChangedExclusiveReadLockStrategy">
        <constructor-arg value="5000" />
     </bean>

    <bean id="nsbnFileTransferProcess" class="com.raytheon.uf.edex.nsbn.NSBNFileTransfer"/>
    <bean id="nsbnIdempotentRepository" class="com.raytheon.uf.edex.nsbn.NSBNIdempotentRepository"/>
    
    <bean id="clusteredNSBNFileTransferProcess" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.nsbn.ClusteredNSBNFileTransferProcessRoutes">
                <constructor-arg name="nsbnDropBox" value="${nsbn.drop.box}" />
            </bean>
        </constructor-arg>
    </bean>

</beans>
