    <bean id="awwDistRegistry" factory-bean="distributionSrv"
		factory-method="register">
		<constructor-arg value="aww" />
		<constructor-arg value="jms-durable:queue:Ingest.aww" />
	</bean>

    <bean id="awwIngestRoute" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="gov.noaa.nws.ncep.edex.plugin.aww.AwwCamelRoutes" />
        </constructor-arg>
    </bean>
