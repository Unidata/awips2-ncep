<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://camel.apache.org/schema/spring
    http://camel.apache.org/schema/spring/camel-spring.xsd">

    <bean id="ncgribFilenameProcessor" class="gov.noaa.nws.ncep.edex.plugin.ncgrib.NcgribFileNameProcessor"/>
    
    <bean id="ncgrib-qpid-endpoint" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="gov.noaa.nws.ncep.edex.plugin.ncgrib.NcgribQpidEndpointRoutes">
                <constructor-arg name="gribSplitThreads" value="${GRIB_SPLIT_THREADS}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>
