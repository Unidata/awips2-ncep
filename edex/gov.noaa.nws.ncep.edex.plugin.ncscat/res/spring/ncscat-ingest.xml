<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://camel.apache.org/schema/spring
    http://camel.apache.org/schema/spring/camel-spring.xsd">

	<bean id="ncscatDao" class="gov.noaa.nws.ncep.edex.plugin.ncscat.dao.NcscatDao">
	<constructor-arg ref="ncscatPluginName"/> 
	</bean>

	<bean id="ncscatDecoder" class="gov.noaa.nws.ncep.edex.plugin.ncscat.decoder.NcscatDecoder">
	<constructor-arg ref="ncscatPluginName"/> 
	</bean>

	
	<bean id="ncscatDistRegistry" factory-bean="distributionSrv"
		factory-method="register">
		<constructor-arg value="ncscat" />
		<constructor-arg value="jms-durable:queue:Ingest.Ncscat" />
	</bean>

    <bean id="ncscat-camel" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="gov.noaa.nws.ncep.edex.plugin.ncscat.decoder.NcscatCamelRoutes" />
        </constructor-arg>
    </bean>
</beans>