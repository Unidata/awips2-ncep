<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="ntransDao" class="gov.noaa.nws.ncep.edex.plugin.ntrans.dao.NtransDao" depends-on="ntransPluginRegistered">
	<constructor-arg ref="ntransPluginName"/> 
	</bean>

	<bean id="ntransDecoder" class="gov.noaa.nws.ncep.edex.plugin.ntrans.decoder.NtransDecoder"/>

	
	<bean id="ntransDistRegistry" factory-bean="distributionSrv"
		factory-method="register">
		<constructor-arg value="ntrans" />
		<constructor-arg value="jms-durable:queue:Ingest.Ntrans" />
	</bean>

     <bean id="ntrans-camel" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="gov.noaa.nws.ncep.edex.plugin.ntrans.decoder.NtransCamelRoutes" />
        </constructor-arg>
    </bean>
</beans>