<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="sshaDecoder"
		class="gov.noaa.nws.ncep.edex.plugin.ssha.decoder.SshaDecoder">
		<constructor-arg ref="sshaPluginName" />
	</bean>

	<bean id="sshaSeparator"
		class="gov.noaa.nws.ncep.edex.plugin.ssha.decoder.SshaSeparator" />

	<bean id="sshaToPointData" class="gov.noaa.nws.ncep.edex.plugin.ssha.dao.SshaPointDataTransform" />



    <bean id="sshaDistRegistry" factory-bean="distributionSrv"
		factory-method="register">
		<constructor-arg ref="sshaPluginName" />
		<constructor-arg value="jms-durable:queue:Ingest.ssha" />
	</bean>

    <bean id="ssha-camel" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="gov.noaa.nws.ncep.edex.plugin.ssha.decoder.SshaCamelRoutes" />
        </constructor-arg>
    </bean>
</beans>